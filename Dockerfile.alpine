FROM alpine:3.24

LABEL org.opencontainers.image.title="ttyd-ng" \
      org.opencontainers.image.source="https://github.com/Lanjelin/ttyd-ng"

ARG TARGETARCH

# Dependencies
RUN apk add --no-cache bash tini

# Application
COPY ./dist/${TARGETARCH}/ttyd /usr/bin/ttyd

EXPOSE 7681
WORKDIR /root

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["ttyd", "-W", "bash"]
